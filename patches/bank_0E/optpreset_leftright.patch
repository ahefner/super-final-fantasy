--- OLD
  @LeftRight:
    CMP #RIGHT              ; did they press Right?
    BNE @Left               ;  if not, they must've pressed Left
    LDA #1                  ; add +1 to rate if right
    BNE :+
       @Left:
         LDA #-1            ; or -1 if left
:   CLC
    ADC respondrate         ; add/subtract 1 from respond rate
    AND #7                  ; mask to wrap it from 0<->7
    STA respondrate

    JSR PlaySFX_MenuMove    ; play the move sound effect, and continue looping!
    JMP @Loop
--- NEW
  @LeftRight:
    ;  Contextual: the column in the two by two, the mode on its row, the
    ;  respond rate on its own, and on Credits nothing -- the move chirp
    ;  opt_titleleftright's, played only when something moved.
    JSL opt_titleleftright + OPTFAR
    JMP @Loop
