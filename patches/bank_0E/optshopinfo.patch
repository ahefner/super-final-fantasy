--- OLD
    JSR ShopFrame        ; now that cursor position has been recorded... do a frame

    LDA joy_b
--- NEW
.import opt_shopframe

    ;  A frame, but first work out which characters can use whatever the
    ;  cursor is on, so they can be drawn cheering -- and afterwards read
    ;  Select, which opens a description of it.
    ;
    ;  Select is read here rather than below because the routine runs a modal
    ;  loop of its own, and the button that closes the box must not then be
    ;  read as a choice.  Everything after this point is the loop as it was.
    JSL opt_shopframe + OPTFAR

    LDA joy_b
