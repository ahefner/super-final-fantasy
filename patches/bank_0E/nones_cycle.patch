--- OLD
      LDX char_index
      CLC
      LDA ptygen_class, X       ; Add 1 to the class ID of the current character.
      ADC #1
      CMP #6
      BCC :+
        LDA #0                  ; wrap 5->0
    : STA ptygen_class, X
--- NEW
.import none_nextclass
  @NextClass:
      LDX char_index
      ;  The next class the Party row lets the slot have: Fighter to Black
      ;  Mage, then None, then round again, past what it does not allow.
      JSL none_nextclass + OPTFAR
      .res 17 - (* - @NextClass), $EA
