--- OLD
    DEC item_house          ; otherwise... remove a house from our inventory
    LDA #120
    JSR MenuRecoverPartyHP  ; give the whole party 120 HP
    LDA #$1E
--- NEW
.export MenuRecoverPartyMP      ; House Restoration reaches all three from the
.export MenuFillPartyHP         ;   options chunk, through OptCallFar
.export DrawItemTargetMenu
.import opt_housemp

    DEC item_house          ; otherwise... remove a house from our inventory
    LDA #120
    JSR MenuRecoverPartyHP  ; give the whole party 120 HP

    ;  ...and then the rest of the HP, and the MP, if House Restoration is on.
    ;  Both have to happen here, in front of the save, or the file written
    ;  below still holds the old values.  The 120 above is left alone: with the
    ;  flag on the fill that follows makes it redundant rather than wrong, and
    ;  leaving it keeps this patch to the one JSL this bank has room for.
    ;  See opt_housemp for what vanilla does instead.
    JSL opt_housemp + OPTFAR

    LDA #$1E
