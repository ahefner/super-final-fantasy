    ;  evasion and strength.  Originally HPMAX, HPMAX+1, ABSORB, EVADE, DAMAGE.
    .BYTE ENROMSTAT_CRITRATE,   en_hp
    .BYTE ENROMSTAT_CATEGORY,   en_hp+1
    .BYTE ENROMSTAT_EXP,        en_defense
    .BYTE ENROMSTAT_MORALE,     en_morale
    .BYTE ENROMSTAT_EXP,        en_evade
    .BYTE ENROMSTAT_EXP,        en_strength
