--- NEW
.export CondReSortParty, ChkAliveX, ChkAliveY
.import ReSortPartyByAilment
.import opt_chkalivex, opt_chkalivey

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;;  No Party Shuffle
;;
;;    Three hooks for banks $0C and $0E, which have no room between them.  The
;;  call sites keep the size of what they replace, so the decision happens
;;  here.  Two of the three are only trampolines: the fixed bank is stamped
;;  into every chunk, so a byte spent here is spent thirty times over and
;;  never comes back, while the options bank has thousands going spare.
;;
;;    CondReSortParty has to stay, because it finishes by jumping into bank
;;  $0C and a JSL would leave the program bank pointing at the options bank.
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

CondReSortParty:
    LDA OPTFB_NOSHUFFLE
    AND #OPTFM_NOSHUFFLE
    BNE :+
      JMP ReSortPartyByAilment
:   RTS

ChkAliveX:
    JSL opt_chkalivex + OPTFAR
    RTS

ChkAliveY:
    JSL opt_chkalivey + OPTFAR
    RTS


