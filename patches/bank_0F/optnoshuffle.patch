--- NEW
.export CondReSortParty, ChkAliveX, ChkAliveY
.import ReSortPartyByAilment

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;;  No Party Shuffle
;;
;;    Three hooks, all of them sited here rather than in the banks they are
;;  called from.  Bank $0C has no free bytes at all and bank $0E has forty, so
;;  the call sites stay exactly the size of what they replace and the thinking
;;  happens up here, where the fixed bank has room.
;;
;;    CondReSortParty stands in for the JSR at the top of ExitBattle that
;;  rearranges the party to put the dead and the stoned at the back.
;;
;;    ChkAliveX and ChkAliveY stand in for the two loads in the lineup menu
;;  that decide whether a swap would leave a dead character in the lead slot.
;;  Reporting zero means "alive", which is what lets the swap through.  Both
;;  set Z from the value they return, because the branch that follows the call
;;  site is reading it.
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

CondReSortParty:
    LDA OPTFB_NOSHUFFLE
    AND #OPTFM_NOSHUFFLE
    BNE :+
      JMP ReSortPartyByAilment
:   RTS

ChkAliveX:
    LDA OPTFB_NOSHUFFLE
    AND #OPTFM_NOSHUFFLE
    BNE :+
      LDA str_buf, X
      RTS
:   LDA #$00              ; "alive", so the lineup menu allows the swap
    RTS

ChkAliveY:
    LDA OPTFB_NOSHUFFLE
    AND #OPTFM_NOSHUFFLE
    BNE :+
      LDA str_buf, Y
      RTS
:   LDA #$00
    RTS



