--- OLD
BattleRNG:
    LDX btl_rngstate
    INC btl_rngstate
    LDA @Scramble_lut, X
    RTS
    
  @Scramble_lut:
    .INCBIN "bin/0F_FCF1_rngtable.bin"
--- NEW
BattleRNG:
    ;  The table itself moved to the options chunk (optdata.asm); this reads
    ;  the randomizer's copy of it, which RNG tables may have shuffled.  No
    ;  ensure: every battle comes through rando_formdata, which has made the
    ;  cache match the save before any battle roll.
    LDX btl_rngstate
    INC btl_rngstate
    LDA f:RW_BATRNG, X
    RTS
