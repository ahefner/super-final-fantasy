--- OLD
CHRLoad_Cont:
    LDA (tmp), Y      ; read a byte from source pointer
    STA $2007         ; and write it to CHR-RAM
    INY               ; inc our source index
    BNE CHRLoad_Cont  ; if it didn't wrap, continue looping

    INC tmp+1         ; if it did wrap, inc the high byte of our source pointer
    DEX               ; and decrement our row counter (256 bytes = a full row of tiles)
    BNE CHRLoad_Cont  ; if we've loaded all requested rows, exit.  Otherwise continue loading
    RTS

--- NEW
.import fun_chrload
.export CHRLoad_Cont, LoadTilesetAndMenuCHR, LoadShopBGCHRPalettes   ; for tools/test_options.py
.export LoadBattleBGCHRAndPalettes                                   ;   (test_graphics)
CHRLoad_Cont:
    ;  Handed to the HAL as one run rather than a byte at a time through $2007;
    ;  see hal_chrload.  Same source pointer, same row count, same exit state.
    ;  Through FUN%'s Graphics row, which on Japan puts the Japanese tiles in
    ;  after it (fun_chrload).
    JSL fun_chrload + FUNFAR
    RTS
