--- OLD
DrawBoxRow_Top:
    JSR MenuCondStall   ; Do the conditional stall
    LDA $2002           ; reset PPU toggle
    LDA ppu_dest+1
    STA $2006           ; set PPU Address appropriately
    LDA ppu_dest
    STA $2006

    LDX tmp+10          ; load the adjusted width into X (our loop counter)
    LDA #$F7            ; F7 = UL border tile
    STA $2007           ;   draw UL border

    LDA #$F8            ; F8 = U border tile
@Loop:
      STA $2007         ;   draw U border
      DEX               ;     until X expires
      BNE @Loop

    LDA #$F9            ; F9 = UR border tile
    STA $2007           ;   draw it

    LDA ppu_dest        ; Add #$20 to our input PPU address so that it
    CLC                 ;  points to the next row
    ADC #$20
    STA ppu_dest
    LDA ppu_dest+1
    ADC #0              ; Add 0 to catch the carry
    STA ppu_dest+1

    RTS

--- NEW
DrawBoxRow_Top:
    JSR MenuCondStall   ; Do the conditional stall
    LDA $2002           ; reset PPU toggle
    LDA ppu_dest+1
    STA $2006           ; set PPU Address appropriately
    LDA ppu_dest
    STA $2006

    LDX tmp+10          ; load the adjusted width into X (our loop counter)
    LDA #$F7            ; F7 = UL border tile
    STA $2007           ;   draw UL border

    LDA #$F8            ; F8 = U border tile
    ;  The run of identical tiles goes to the HAL as one call rather than
    ;  a byte at a time through $2007; see hal_ntfill.  X still holds the
    ;  width on entry, and is put back to zero afterwards so the exit
    ;  state matches the loop this replaces.
    JSL hal_ntfill + HALFAR
    LDX #$00

    LDA #$F9            ; F9 = UR border tile
    STA $2007           ;   draw it

    LDA ppu_dest        ; Add #$20 to our input PPU address so that it
    CLC                 ;  points to the next row
    ADC #$20
    STA ppu_dest
    LDA ppu_dest+1
    ADC #0              ; Add 0 to catch the carry
    STA ppu_dest+1

    RTS
