--- OLD
    LDX tmp                ; delay 'tmp' scanlines
    @LinesDelay:
      JSR WaitAltarScanline
      DEX
      BNE @LinesDelay
          PAGECHECK @LinesDelay

    LDX tmp+1              ; then illuminate 'tmp+1' scanlines
    @LinesIllum:
      JSR DoAltarScanline
      DEX
      BNE @LinesIllum
          PAGECHECK @LinesIllum
--- NEW
    ;  One call is one frame of the beam.  Its shape is a table in ROM, built
    ;  by tools/genbeam.py, so nothing about the geometry is worked out at run
    ;  time -- the HAL only advances the frame.  AltarFrame above still waits
    ;  for vblank, so this loop still runs once a frame and still owns the
    ;  screen shake and the sound effect.  WaitAltarScanline and
    ;  DoAltarScanline are now unreachable.
    JSL hal_altarband + HALFAR
