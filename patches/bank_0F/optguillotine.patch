--- NEW
.export OptGuillotine
.import rando_talk

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;;  The talk funnel
;;
;;    Every talk dispatch in TalkToObject ends here, in place of its
;;  JMP (tmp+6), so the call sites stay three bytes: bank $0E's object data is
;;  pinned at $95D5 and TalkToObject sits above it.  The decisions are far, in
;;  rando_talk: the reward NPCs, run from a table once a new game has set
;;  RANDO_TALK, and NPC Guillotine, which may swap the handler before the jump.
;;
;;    In: (tmp+6) = the handler TalkToObject resolved, X = the object index,
;;  tmp..tmp+3 the object's talk data.
;;    Out: A = the dialogue id, returned as a handler returns it -- by
;;  rando_talk, or by the handler this jumps to.
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

OptGuillotine:
    JSL rando_talk + RANDOFAR
    BCC @dispatch
    RTS                 ; handled far: A = the dialogue id
  @dispatch:
    JMP (tmp+6)         ; the handler, which Guillotine may have swapped


