--- NEW
.export OptRunFail, lut_WaitString
.import opt_runiswait, DrawBtlMsg_ClearCombatBoxes

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;;  Run -> Wait
;;
;;    Only the two pieces that cannot live anywhere else are here.  OptRunFail
;;  ends by jumping into bank $0C, so it has to run with that bank swapped in;
;;  lut_WaitString is fetched through btl_msgdraw_srcptr while the battle bank
;;  is in at $8000, so it has to be above $C000, which every chunk carries.
;;  The decision and the label swap are in the options bank -- this bank has
;;  28 bytes to its name.
;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

OptRunFail:
    JSL opt_runiswait + OPTFAR      ; carry set: the fight was never runnable
    LDA #BTLMSG_CANTRUN
    BCC @draw
      LDA #BTLMSG_NOTHINGHAPPENS
  @draw:
    JMP DrawBtlMsg_ClearCombatBoxes

lut_WaitString:
  .BYTE $A0, $8A, $92, $9D, $00     ; "WAIT"


