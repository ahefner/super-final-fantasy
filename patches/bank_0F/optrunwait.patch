--- OLD
DrawCommandBox:
    LDY #$00
    LDX #$00
  @Loop:
      LDA lua_BattleCommandBoxInfo, Y           ; copy 6*5 bytes (6 blocks)
      STA btl_msgdraw_hdr, X
      INX
      CPX #$05
      BNE :+                                    ; every 5 bytes, add the block to the
        JSR BattleDraw_AddBlockToBuffer         ;  output buffer
        LDX #$00
    : INY
      CPY #6*5              ; 6 blocks * 5 bytes per block
      BNE @Loop
      
    JMP DrawBlockBuffer            ; then finally draw it
--- NEW
;  Run -> Wait is off for now: putting the vanilla message-box loops back
;  needed 32 bytes the fixed bank did not have, and this feature was the
;  largest thing in it.  Restored next, with its body moved to the
;  options bank so it costs the fixed bank almost nothing.
DrawCommandBox:
    LDY #$00
    LDX #$00
  @Loop:
      LDA lua_BattleCommandBoxInfo, Y           ; copy 6*5 bytes (6 blocks)
      STA btl_msgdraw_hdr, X
      INX
      CPX #$05
      BNE :+                                    ; every 5 bytes, add the block to the
        JSR BattleDraw_AddBlockToBuffer         ;  output buffer
        LDX #$00
    : INY
      CPY #6*5              ; 6 blocks * 5 bytes per block
      BNE @Loop
      
    JMP DrawBlockBuffer            ; then finally draw it
