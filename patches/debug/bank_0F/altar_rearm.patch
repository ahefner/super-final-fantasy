--- OLD
SMMove_EarthOrb:
    LDA orb_earth          ; see if orb already lit
    BNE SMMove_OK          ; if it is, just have player move normally
.import opt_orbearth, opt_orbfire, opt_orbwater, opt_orbair
    JSL opt_orbearth + OPTFAR   ; otherwise, light up the orb -- and under
    NOP                         ;   Shard Hunt its fiend's SHARDs (optbank.asm)
    BNE SMMove_AltarEffect ; and do the altar effect (always branches)

SMMove_FireOrb:
    LDA orb_fire
    BNE SMMove_OK
    JSL opt_orbfire + OPTFAR
    NOP
    BNE SMMove_AltarEffect

SMMove_WaterOrb:
    LDA orb_water
    BNE SMMove_OK
    JSL opt_orbwater + OPTFAR
    NOP
    BNE SMMove_AltarEffect

SMMove_AirOrb:
    LDA orb_air
    BNE SMMove_OK
    JSL opt_orbair + OPTFAR
    NOP                   ; (A = 1) flows directly into the altar effect
--- NEW
SMMove_EarthOrb:
    ;  DEBUG BUILD ONLY: the "already lit" check is gone from all four altars,
    ;  so each can be stepped on as many times as you like.  The orb flags are
    ;  still set, so game state stays honest; what changes is only that a lit
    ;  orb's altar fires again instead of doing nothing.
.import opt_orbearth, opt_orbfire, opt_orbwater, opt_orbair
    JSL opt_orbearth + OPTFAR   ; light up the orb (and Shard Hunt's SHARDs)
    NOP
    BNE SMMove_AltarEffect ; and do the altar effect (always branches)

SMMove_FireOrb:
    JSL opt_orbfire + OPTFAR
    NOP
    BNE SMMove_AltarEffect

SMMove_WaterOrb:
    JSL opt_orbwater + OPTFAR
    NOP
    BNE SMMove_AltarEffect

SMMove_AirOrb:
    JSL opt_orbair + OPTFAR
    NOP                   ; (A = 1) flows directly into the altar effect
